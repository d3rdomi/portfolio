---
import BaseHead from '../../../components/BaseHead.astro';
import { getCollection } from 'astro:content';
import '../../../styles/global-style.css';
import '../../../styles/photography-style.css';
import MyFooter from '../../../components/MyFooter.astro';
import Navbar from '../../../components/Navbar.astro';
import { getLangFromUrl, useTranslations, localizePath, pick } from '../../../i18n/utils';
import LangSwitch from '../../../components/LangSwitch.astro';
import MobileNav from '../../../components/MobileNav.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// Neueste Aufnahmen zuerst (Jahr, dann Monat). Einträge ohne Jahr stehen am Ende.
const shotKey = (post: (typeof allPosts)[number]) => {
	const { year, month } = post.data.shotDate ?? {};
	return year ? year * 100 + (month || 0) : -1;
};
const allPosts = await getCollection('photography');
const posts = allPosts.sort(
	(a, b) => shotKey(b) - shotKey(a) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={t('site.title')} description={t('site.description')} lang={lang} />
	</head>
	<body>
		<MobileNav />
		<LangSwitch />
		<Navbar class="navbar" />
		<div class="header">
			<h1 class="split-chars">{t('heading.photography')}</h1>
		</div>

		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={localizePath(lang, `/photography/${post.slug}/`)}>
									{post.data.heroImage && <img src={post.data.heroImage} alt={pick(post.data.altText, lang)} />}

									<h2 class="card-title">{post.data.title}</h2>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>

		<MyFooter />

	</body>
</html>
